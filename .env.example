# Copy to .env; never commit real keys
GROQ_API_KEY=replace_with_your_groq_key
GEMINI_API_KEY=replace_with_your_gemini_key
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_VOICE=Kore
ORION_PORT=8787

# TTS_PROVIDER=local (default), edge (free), or gemini
TTS_PROVIDER=local
EDGE_VOICE=en-US-AriaNeural
EDGE_VOICE_TA=ta-LK-SaranyaNeural

# Local speech (needs requirements-local.txt): STT_PROVIDER=local|groq, TTS_PROVIDER=local|edge|gemini
STT_PROVIDER=local
LOCAL_WHISPER_MODEL=large-v3-turbo
LOCAL_VOICE=af_heart
